# PostgreSQL — informe os dados do seu banco; credenciais não são fornecidas pelo repositório.
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Segredo local aleatório. Não reutilize este texto em produção.
JWT_SECRET=troque-por-um-segredo-aleatorio
PORT=3000
NODE_ENV=development

# Cloudflare R2 — necessário para uploads; sem ele o servidor pode iniciar,
# mas os recursos de envio de arquivos retornarão erro de armazenamento.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OAuth é opcional. Configure as credenciais no console de cada provedor.
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=
FACEBOOK_GRAPH_VERSION=
