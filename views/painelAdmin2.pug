extends layout

block styles
  link(rel='stylesheet', href='/stylesheets/painelAdmin2.css')

block content
  .admin-panel-container
    .admin-header-banner
      h1 AudioSense Painel Administrativo - Moderação
      a.admin-mod-link(href="/admin/moderacao")
        i.bi.bi-flag-fill(aria-hidden="true")
        |  Denúncias de posts e materiais

    //- Seção: Cadastros Pendentes
    section.admin-section
      .section-title-group
        p.section-subtitle CADASTROS PENDENTES
        h2.section-title Cadastros de Docentes Pendentes
        p.section-description Usuários que estão se cadastrando como docentes e aguardam aprovação

      .filter-bar
        .search-input-wrapper
          i.bi.bi-search(aria-hidden="true")
          input.search-input(type="text" placeholder="Pesquisar docente..." aria-label="Pesquisar docente")
        select.filter-select(aria-label="Filtrar por status")
          option(value="") Filtrar por Status
          option(value="pendente") Pendente
          option(value="aprovado") Aprovado
          option(value="rejeitado") Rejeitado

      .user-list
        if docentesPendentes.length === 0
          p.section-description Nenhum cadastro pendente no momento.
        else
          each docente in docentesPendentes
            .user-card
              - const fotoDocente = docente.foto_perfil || '/images/foto-perfil-default.png'
              img.user-avatar-img(src=fotoDocente alt=`Foto de ${docente.nome_completo}`)
              .user-info
                p.user-name= docente.nome_completo
                p.user-email= docente.email
                span.user-tag= docente.disciplina || 'Sem disciplina'
              span.status-badge= docente.status_aprovacao
              .action-buttons
                if docente.comprovante_vinculo
                  a.btn-action.btn-view(href=docente.comprovante_vinculo target="_blank")
                  i.bi.bi-file-earmark-text(aria-hidden="true")
                  | Ver Documentos
                form(action=`/painelAdmin1/aprovar/${docente.docente_id}` method="POST" style="display:inline")
                  button.btn-action.btn-approve(type="submit")
                    i.bi.bi-check-lg(aria-hidden="true")
                    | Aprovar
                  button.btn-action.btn-reject(type="button" onclick=`abrirModal('docente', '${docente.docente_id}')`)
                    i.bi.bi-x-lg(aria-hidden="true")
                    | Rejeitar
    //- Seção: Solicitações de Admin
    section.admin-section
      .section-title-group
        p.section-subtitle SOLICITAÇÕES DE ADMIN
        h2.section-title Solicitações para Acesso de Administrador
        p.section-description Docentes aprovados que solicitam acesso de administrador

      .filter-bar
        .search-input-wrapper
          i.bi.bi-search
          input.search-input(type="text" placeholder="Pesquisar docente..." aria-label="Pesquisar docentes que solicitaram acesso de administrador")
        select.filter-select(aria-label="Filtrar solicitações de administrador por status")
          option(value="") Filtrar por Status
          option(value="pendente") Pendente
          option(value="aprovado") Aprovado
          option(value="rejeitado") Rejeitado

      .user-list
        if !solicitacoesAdmin || solicitacoesAdmin.length === 0
          p.section-description Nenhuma solicitação pendente no momento.
        else
          each sol in solicitacoesAdmin
            each sol in solicitacoesAdmin
              .user-card
                - const fotoSol = sol.foto_perfil || '/images/foto-perfil-default.png'
                img.user-avatar-img(src=fotoSol alt=`Foto de ${sol.nome_completo}`)
                .user-info
                  p.user-name= sol.nome_completo
                  p.user-email= sol.email
                  .tags-row
                    span.user-tag.tag-docente Docente Aprovado
                    span.user-tag.tag-pendente Pendente
                  p.user-description= sol.justificativa
                .action-buttons
                form(action=`/painelAdmin1/aprovar-admin/${sol.solicitacao_id}` method="POST" style="display:inline")
                  button.btn-action.btn-approve(type="submit")
                    i.bi.bi-check-lg
                    | Aprovar
                button.btn-action.btn-reject(type="button" onclick=`abrirModal('admin', '${sol.solicitacao_id}')`)
                  i.bi.bi-x-lg
                  | Rejeitar

  //- Modal de rejeição
  .modal-overlay#modalRejeitar(hidden)
    .modal-box(role="dialog" aria-modal="true" aria-labelledby="modal-titulo" tabindex="-1")
      h3#modal-titulo Motivo da rejeição
      label(for="motivoRejeicao") Explique o motivo da rejeição
      textarea#motivoRejeicao(rows="4" placeholder="Explique o motivo da rejeição..." required aria-describedby="modal-titulo")
      .modal-buttons
        button.btn-action.btn-approve(type="button" onclick="confirmarRejeicao()") Confirmar
        button.btn-action.btn-reject(type="button" onclick="fecharModal()") Cancelar
      form#formRejeitar(method="POST" style="display:none")
        input(type="hidden" name="motivo_rejeicao" id="inputMotivo")

  script.
    let urlRejeitar = '';
    let ultimoElementoFocado = null;
    let elementosInertos = [];

    function abrirModal(tipo, id) {
      if (tipo === 'docente') {
        urlRejeitar = `/painelAdmin1/rejeitar/${id}`;
      } else {
        urlRejeitar = `/painelAdmin1/rejeitar-admin/${id}`;
      }
      ultimoElementoFocado = document.activeElement;
      const modal = document.getElementById('modalRejeitar');
      document.getElementById('motivoRejeicao').value = '';
      modal.hidden = false;
      bloquearFundo(modal);
      document.getElementById('motivoRejeicao').focus();
      document.addEventListener('keydown', fecharModalComEsc);
      document.addEventListener('keydown', prenderFocoModal);
    }

    function fecharModal() {
      const modal = document.getElementById('modalRejeitar');
      modal.hidden = true;
      elementosInertos.forEach(el => el.removeAttribute('inert'));
      elementosInertos = [];
      document.removeEventListener('keydown', fecharModalComEsc);
      document.removeEventListener('keydown', prenderFocoModal);
      if (ultimoElementoFocado) {
        ultimoElementoFocado.focus();
        ultimoElementoFocado = null;
      }
    }

    function bloquearFundo(modal) {
      elementosInertos = [];
      let node = modal;
      while (node && node !== document.body) {
        const parent = node.parentElement;
        if (parent) {
          Array.from(parent.children).forEach(irmao => {
            if (irmao === node || ['SCRIPT', 'STYLE', 'LINK'].includes(irmao.tagName) || irmao.hasAttribute('inert')) return;
            irmao.setAttribute('inert', '');
            elementosInertos.push(irmao);
          });
        }
        node = parent;
      }
    }

    function fecharModalComEsc(e) {
      if (e.key === 'Escape') fecharModal();
    }

    function prenderFocoModal(e) {
      if (e.key !== 'Tab') return;
      const modal = document.getElementById('modalRejeitar');
      const focaveis = Array.from(modal.querySelectorAll('button:not([disabled]), textarea'))
        .filter(el => el.offsetParent !== null);
      if (!focaveis.length) {
        e.preventDefault();
        modal.querySelector('[role="dialog"]').focus();
        return;
      }
      const primeiro = focaveis[0];
      const ultimo = focaveis[focaveis.length - 1];
      if (e.shiftKey && (document.activeElement === primeiro || document.activeElement === modal.querySelector('[role="dialog"]'))) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && (document.activeElement === ultimo || !modal.contains(document.activeElement))) {
        e.preventDefault();
        primeiro.focus();
      }
    }

    function confirmarRejeicao() {
      const motivo = document.getElementById('motivoRejeicao').value.trim();
      if (!motivo) {
        alert('Por favor, informe o motivo da rejeição.');
        return;
      }
      const form = document.getElementById('formRejeitar');
      form.action = urlRejeitar;
      document.getElementById('inputMotivo').value = motivo;
      form.style.display = 'block';
      form.submit();
    }

    document.getElementById('modalRejeitar').addEventListener('click', function(e) {
      if (e.target === this) fecharModal();
    });