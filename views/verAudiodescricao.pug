extends layout

block styles
  link(rel='stylesheet', href='/stylesheets/inserirAudiodescricao.css')
  link(rel='stylesheet', href='/stylesheets/audiodescricao.css')

block content
  main.page
    h1.title Audiodescrição autoral

    section.container-form
      h2.form-title= projeto.titulo

      .form-group
        p.form-group-label Descrição
        p.form-control(style="margin:0")= projeto.descricao

      .form-group
        p.form-group-label Mídia
        if projeto.tipo_midia === 'video'
          if projeto.audio_final_url
            video(controls style="width:100%; max-height:400px; border-radius:12px; border: 2px solid #582d86;")
              source(src=projeto.audio_final_url)
              | Seu navegador não suporta vídeo.
          else
            .projeto-resumo-placeholder(style="width:100%; height:200px;")
              i.bi.bi-film(aria-hidden="true")
        else
          img(src=projeto.imagem_url alt=projeto.titulo style="width:100%; max-height:400px; object-fit:contain; border-radius:12px; border: 2px solid #582d86;")

      .form-group
        p.form-group-label Roteiro
        .form-control(style="min-height:120px; white-space: pre-wrap")= projeto.roteiro_texto

      if projeto.tipo_midia === 'imagem' && projeto.audio_final_url
        .form-group
          p.form-group-label Áudio final
          audio(controls style="width:100%; margin-top:8px")
            source(src=projeto.audio_final_url)
            | Seu navegador não suporta áudio.

      .form-group
        p.form-group-label Status
        p.form-control(style="margin:0")= projeto.status

      if projeto.data_aprovacao
        .form-group
          p.form-group-label Aprovado em
          p.form-control(style="margin:0")= new Date(projeto.data_aprovacao).toLocaleDateString('pt-BR')

      .button-group
        a.btn-cancel(href="/usuario/perfil") Voltar ao perfil