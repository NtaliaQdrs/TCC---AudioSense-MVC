extends layout

block styles
  link(rel='stylesheet', href='/stylesheets/audiodescricao.css')

block content
  main.page(role="main")
  
    h1.title Introdução a audiodescrição

    section.cards-extra
      .main-grid

        article.extra-card1.card1
          .card-inner
            img(src="../images/definicao.png" alt="")
            h2 Definição e conceitos
            .card-content(id="card-content-1" aria-hidden="true")
              p A audiodescrição é um recurso de acessibilidade comunicacional, que traduz imagens em palavras, possibilitando que as pessoas que se beneficiam desse recurso tenham acesso às informações visuais.

              p Trata-se de uma tradução intersemiótica, que traduz informações imagéticas para informações verbais.

              p Intersemiótica é a transmutação de um sistema de signos para outro, nesse caso, de um sistema não verbal, imagético, para o verbal.

            button.read-more(type="button" onclick="toggleFullscreen(this)" aria-expanded="false" aria-controls="card-content-1") Ler mais

        article.extra-card.card2
          .card-inner
            img(src="../images/usuarios.png" alt="")
            h2 Quem são os usuários?
            .card-content(id="card-content-2" aria-hidden="true")
              p Este recurso beneficia principalmente pessoas com deficiência visual, entre elas cegas e com baixa visão.
              p E amplia a compreensão, como uma segunda forma de acesso à comunicação, para pessoas com deficiência intelectual, com TDAH, autistas, disléxicos, idosos e crianças.
              p No contexto educacional, ela auxilia estudantes a focarem em detalhes importantes de imagens técnicas ou mapas, tornando o aprendizado mais robusto para todos os tipos de perfis cognitivos.
            button.read-more(onclick="toggleFullscreen(this)") Ler mais

        article.extra-card.card3
          .card-inner
            img(src="../images/importancia.png" alt="")
            h2 A importância deste recurso
            .card-content(id="card-content-3" aria-hidden="true")
              p Este recurso é necessário em quaisquer lugares que tenham informações visuais para fruição, tais como: sites, cinema, teatro, escola, programas televisivos, passeios turísticos, shows, desfiles, apresentações de dança, e tantos outros.

              p Ela oportuniza:

              p  - a locomoção nos espaços com autonomia;
              p  - a participação em eventos artísticos culturais em igualdade com os demais;
              p  - o acesso à informação;
              p  - a navegação por ambientes virtuais com independência;
              p  - o acesso a internet com autonomia;


            button.read-more(onclick="toggleFullscreen(this)") Ler mais

        article.extra-card1.card4
          .card-inner
            img(src="../images/exemplos.png" alt="")
            h2 Exemplos práticos
            .card-content(id="card-content-4" aria-hidden="true")
              p Exemplos incluem a descrição de cenários, expressões faciais, figurinos e ações físicas que não são reveladas apenas pelo som ou pelo diálogo em uma produção audiovisual.
              .exemplos-galeria
                figure.exemplo-item
                  img(src="/images/exemplo1.png", alt="Exemplo prático de audiodescrição 1")
                  figcaption
                    strong Exemplo 1:
                    |  Pintura vertical. Uma figura de corpo esguio com o rosto pálido e arredondado, olhos bem abertos e boca ovulada, está sobre uma ponte de madeira com parapeito, diante de um corpo d'água sinuoso e um céu com faixas horizontais amarelas e vermelhas. Vê-se de perto a figura com as duas mãos apoiadas nas laterais da cabeça e a boca aberta. 

                figure.exemplo-item
                  img(src="/images/exemplo2.png", alt="Exemplo prático de audiodescrição 2")
                  figcaption
                    strong Exemplo 2:
                    |  Fotografia colorida na qual vê-se de perto a cabeça do animal. Um gato de pelagem predominantemente branca com manchas beges nas orelhas e olhos abertos está em um cômodo interno com teto de madeira, lâmpada acesa e araras com roupas ao fundo. O gato projeta a cabeça em direção à câmera com a língua rosa estendida para fora da boca. 
                figure.exemplo-item
                  img(src="/images/exemplo3.png", alt="Exemplo prático de audiodescrição 3")
                  figcaption
                    strong Exemplo 3:
                    |  Cartaz vertical com informações em texto nas extremidades superior e inferior. Um homem com bigode vestindo camisa clara, uma mulher de vestido branco com colar colorido e duas crianças à frente estão em um local ao ar livre, diante do mar e de um céu azul claro. O homem e as crianças mostram os dentes em um sorriso direcionado à câmera, enquanto a mulher olha para a frente com os lábios fechados e segura uma mecha do cabelo da criança ao seu lado. 

            button.read-more(onclick="toggleFullscreen(this)") Ler mais

        // SIDEBAR
        aside.sidebar(aria-labelledby="sidebar-title")
          h3#sidebar-title Sugestão de conteúdo adicional

          nav(aria-label="Links complementares")
            ul(style="list-style: none; padding: 0;")
              li
                .sidebar-item
                  i.bi.bi-file-earmark-text(aria-hidden="true")
                  small.text Artigos
                ul.sidebar-links(style="list-style: none; padding: 0; margin: 6px 0 0;")
                  li
                    a(href="https://www.scielo.br/j/rbee/a/fxpVTrGRt8jp7CrPjcP6HFP/" target="_blank" rel="noopener" aria-label="Acessibilidade Audiovisual: Análise de Canais Infantis do YouTube, SciELO (abre em nova aba)")
                      | Acessibilidade Audiovisual em canais do YouTube (SciELO)
              hr

              li
                .sidebar-item
                  i.bi.bi-play-btn(aria-hidden="true")
                  small.text Vídeos educacionais
                ul.sidebar-links(style="list-style: none; padding: 0; margin: 6px 0 0;")
                  li
                    a(href="https://www.youtube.com/watch?v=jByXBdh-Ybg" target="_blank" rel="noopener" aria-label="Introdução à audiodescrição didática, vídeo no YouTube (abre em nova aba)")
                      | Introdução à audiodescrição didática
                  li
                    a(href="https://www.youtube.com/watch?v=4eORinNAON8" target="_blank" rel="noopener" aria-label="O que é e como se faz Audiodescrição, vídeo no YouTube (abre em nova aba)")
                      | O que é e como se faz Audiodescrição
                  li
                    a(href="https://m.youtube.com/watch?v=nfjoiBTchnE" target="_blank" rel="noopener" aria-label="Como fazer audiodescrição em sala de aula, vídeo no YouTube (abre em nova aba)")
                      | Audiodescrição em sala de aula
              hr

              li
                .sidebar-item
                  i.bi.bi-people(aria-hidden="true")
                  small.text Relatos
                ul.sidebar-links(style="list-style: none; padding: 0; margin: 6px 0 0;")
                  li
                    a(href="https://agenciadenoticias.uniceub.br/cidadania-e-diversidade/luta-das-pessoas-com-deficiencia-audiodescricao-significa-os-olhos-emprestados/" target="_blank" rel="noopener" aria-label="Entrevista com Marcos Lima, criador do canal Histórias de Cego (abre em nova aba)")
                      | Relato de Luciane Molina, consultora em AD
              hr

          button.toggle-sidebar(
            type="button"
            onclick="toggleSidebar()"
            aria-expanded="true"
            aria-label="Expandir ou recolher menu"
          ) ↑

    if usuarioLogado && usuarioLogado.tipo_usuario === 'discente'
      .practice
        h2 Coloque em prática o que você aprendeu!
        br
        if projetoEmAnalise
          .a.aviso-analise
            i.bi.bi-hourglass-split(aria-hidden="true")
            .aviso-analise-texto
              p Você já possui uma audiodescrição em processo de correção:
                strong  #{projetoEmAnalise.titulo}
              p Você poderá enviar uma nova assim que ela for corrigida.
        else
          p Teste aqui o que você aprendeu sobre audiodescrição. Escolha uma imagem ou um pequeno vídeo e tente descrevê-lo, transmitindo todas as informações visuais.
          a(href="/inserir-audiodescricao") Inserir audiodescrição

    if !(usuarioLogado)
      .practice
        h2 Coloque em prática o que você aprendeu!
        br
        p Teste aqui o que você aprendeu sobre audiodescrição. Escolha uma imagem ou um pequeno vídeo e tente descrevê-lo, transmitindo todas as informações visuais. 
        p Faça as audiodescrição da usando a fórmula: O que é; quem é? onde? O que está fazendo? 
        p (Formato + sujeito + paisagem + ação)
        p Não utilize termos técnicos como: primeiro plano, close, opte por vê-se de perto.

        a(href="/inserir-audiodescricao") Inserir audiodescrição

    if usuarioLogado && usuarioLogado.tipo_usuario === 'docente'
      .practice
        h2 Audiodescrições para corrigir
        br
        if projetosParaCorrigir.length === 0
          p Nenhuma audiodescrição aguardando correção no momento.
        else
          each projeto in projetosParaCorrigir
            .projeto-card
              .projeto-card-info
                h3= projeto.titulo
                p.projeto-autor
                  | Enviado por: 
                  strong= projeto.UsuarioDiscente.Usuario.nome_completo
                p.projeto-descricao= projeto.descricao
              span.status-badge= projeto.status
              a.btn-corrigir(href=`/corrigir-audiodescricao/${projeto.id}`) Corrigir

  // Botão flutuante que abre/fecha a sidebar no mobile (fica fora do .main-grid,
  // então não é afetado pelo transform aplicado na .sidebar)
  button.sidebar-fab(
    id="sidebarFab"
    type="button"
    aria-label="Abrir sugestões de conteúdo"
    aria-expanded="false"
  )
    i.bi.bi-funnel(aria-hidden="true")

  // Overlay para fechar o card expandido (ou a sidebar) clicando fora
  #overlay.card-overlay(onclick="closeAllCards()")

  script.
    const sidebarFab = document.getElementById('sidebarFab');
    const sidebarEl = document.querySelector('.sidebar');
    const sidebarOverlay = document.getElementById('overlay');

    if (sidebarFab && sidebarEl) {
      sidebarFab.addEventListener('click', () => {
        const isOpen = sidebarEl.classList.toggle('mobile-open');
        sidebarOverlay.classList.toggle('active', isOpen);
        sidebarFab.setAttribute('aria-expanded', isOpen);
      });

      sidebarOverlay.addEventListener('click', () => {
        sidebarEl.classList.remove('mobile-open');
        sidebarOverlay.classList.remove('active');
        sidebarFab.setAttribute('aria-expanded', 'false');
      });
    }

    let lastFocusedElement = null;
    let inertedElements = [];

    function getFocusableElements(container) {
      return Array.from(
        container.querySelectorAll(
          'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    function hideBackgroundExcept(card, overlay) {
      inertedElements = [];
      let node = card;
      while (node && node !== document.body) {
        const parent = node.parentElement;
        if (parent) {
          Array.from(parent.children).forEach(sibling => {
            if (sibling !== node && sibling !== overlay) {
              sibling.setAttribute('inert', '');
              inertedElements.push(sibling);
            }
          });
        }
        node = parent;
      }
    }

    function restoreBackground() {
      inertedElements.forEach(el => el.removeAttribute('inert'));
      inertedElements = [];
    }

    function toggleFullscreen(button) {
      const card = button.closest('article');
      const content = card.querySelector('.card-content');
      const overlay = document.getElementById('overlay');

      if (card.classList.contains('fullscreen')) {
        closeAllCards();
      } else {
        closeAllCards();

        lastFocusedElement = button;

        card.classList.add('fullscreen');
        overlay.classList.add('active');
        button.textContent = 'Fechar';
        button.setAttribute('aria-expanded', 'true');
        content.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';

        card.setAttribute('role', 'dialog');
        card.setAttribute('aria-modal', 'true');
        card.setAttribute('tabindex', '-1');

        const titulo = card.querySelector('h2');
        if (titulo) {
          if (!titulo.id) titulo.id = 'titulo-dialog-' + Math.random().toString(36).slice(2);
          card.setAttribute('aria-labelledby', titulo.id);
        }

        if (!content.id) content.id = 'conteudo-dialog-' + Math.random().toString(36).slice(2);
        card.setAttribute('aria-describedby', content.id);

        hideBackgroundExcept(card, overlay);

        card.focus();

        document.addEventListener('keydown', handleEscKey);
        document.addEventListener('keydown', handleTrapFocus);
      }
    }

    function handleTrapFocus(e) {
      if (e.key !== 'Tab') return;

      const card = document.querySelector('article.fullscreen');
      if (!card) return;

      const focusable = getFocusableElements(card);
      if (focusable.length === 0) {
        e.preventDefault();
        card.focus();
        return;
      }

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && (document.activeElement === first || document.activeElement === card)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function handleEscKey(e) {
      if (e.key === 'Escape') closeAllCards();
    }

    function closeAllCards() {
      const cards = document.querySelectorAll('article.fullscreen');
      const overlay = document.getElementById('overlay');

      cards.forEach(card => {
        card.classList.remove('fullscreen');
        const btn = card.querySelector('.read-more');
        const content = card.querySelector('.card-content');
        if (btn) {
          btn.textContent = 'Ler mais';
          btn.setAttribute('aria-expanded', 'false');
        }
        if (content) content.setAttribute('aria-hidden', 'true');

        card.removeAttribute('role');
        card.removeAttribute('aria-modal');
        card.removeAttribute('aria-labelledby');
        card.removeAttribute('aria-describedby');
        card.removeAttribute('tabindex');
      });

      overlay.classList.remove('active');
      document.body.style.overflow = 'auto';

      restoreBackground();
      document.removeEventListener('keydown', handleEscKey);
      document.removeEventListener('keydown', handleTrapFocus);

      if (lastFocusedElement) {
        lastFocusedElement.focus();
        lastFocusedElement = null;
      }
    }

    function toggleSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const wrapper = document.querySelector('.main-grid');
      const button = document.querySelector('.toggle-sidebar');

      const isCollapsed = sidebar.classList.toggle('collapsed');
      wrapper.classList.toggle('sidebar-collapsed');

      button.textContent = isCollapsed ? '↓' : '↑';
      button.setAttribute('aria-expanded', String(!isCollapsed));
    }
