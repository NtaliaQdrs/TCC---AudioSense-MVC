extends layout

block styles
  link(rel='stylesheet', href='/stylesheets/entretenimento.css')

block content

  main.page
    h1.title Entretenimento acessível

    section.cards-extra
      .main-grid

        if recomendacoes && recomendacoes.length
          each rec in recomendacoes
            article.extra-card1
              .card-inner
                if rec.obra.poster_url
                  img(src=rec.obra.poster_url alt=rec.obra.titulo)
                else
                  .poster-placeholder
                    i.bi.bi-film

                .card-text
                  h2= rec.obra.titulo

                  //- Sinopse curta — visível no card fechado, some no fullscreen via CSS
                  p= rec.obra.sinopse

                  if rec.obra.data_lancamento
                    p.release-date
                      | Lançamento: 
                      = new Date(rec.obra.data_lancamento).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })
                  //- Sinopse longa — visível só no fullscreen
                  .card-content
                    p= rec.obra.sinopse

                  .card-footer
                    .docente-info
                      if rec.docente && rec.docente.usuario
                        if rec.docente.usuario.foto_perfil
                          img.docente-foto(src=rec.docente.usuario.foto_perfil alt=rec.docente.usuario.nome_usuario)
                        else
                          img.docente-foto(src='/images/foto-perfil-default.png' alt='Docente')
                        span.docente-nome Recomendado por @#{rec.docente.usuario.nome_usuario}

                    .platform
                      if rec.plataforma.logo_url
                        img.netflix-icon(src=rec.plataforma.logo_url alt=rec.plataforma.nome)
                      span Acesse na #{rec.plataforma.nome}


                    button.expand-btn(onclick="toggleFullscreen(this)" aria-label="Ver mais detalhes" aria-expanded="false") ⤢

        else
          p.sem-conteudo Nenhuma recomendação cadastrada ainda.

        div.right-column

          aside.sidebar(aria-labelledby="sidebar-title")
            h3#sidebar-title Sugestão de conteúdo adicional

            nav(aria-label="Links complementares")
              ul(style="list-style: none; padding: 0;")
                li
                  .sidebar-item
                    i.bi.bi-file-earmark-text(aria-hidden="true")
                    small.text Artigos
                  a(href="#") (Links para leitura)
                hr

                li
                  .sidebar-item
                    i.bi.bi-play-btn(aria-hidden="true")
                    small.text Vídeos educacionais
                  a(href="#") (Links de vídeos)
                hr

                li
                  .sidebar-item
                    i.bi.bi-people(aria-hidden="true")
                    small.text Relatos
                  a(href="#") (Depoimentos)
                hr

            button.toggle-sidebar(
              onclick="toggleSidebar()"
              aria-expanded="true"
              aria-label="Expandir ou recolher menu") ↑

            if usuario && (usuario.tipo_usuario === 'docente' || usuario.is_admin)
              button.recommend-btn(aria-label="Recomende algo!" onclick="window.location.href='/inserir-entretenimento'")
                i.bi.bi-hand-thumbs-up(aria-hidden="true")
                span   Recomende algo!

  #overlay.card-overlay(onclick="closeAllCards()")

  script(src="/javascripts/entretenimento.js")
  script.
    function toggleSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const button = document.querySelector('.toggle-sidebar');
      const grid = document.querySelector('.main-grid');
      const recommendBtn = document.querySelector('.recommend-btn');
      const isCollapsed = sidebar.classList.toggle('collapsed');
      grid.classList.toggle('sidebar-collapsed', isCollapsed);
      button.textContent = isCollapsed ? '↓' : '↑';
      button.setAttribute('aria-expanded', !isCollapsed);

      if (recommendBtn) {
        if (isCollapsed) {
          recommendBtn.innerHTML = '<i class="bi bi-hand-thumbs-up"></i>';
          recommendBtn.style.width = '40px';
          recommendBtn.style.borderRadius = '50%';
          recommendBtn.style.padding = '0';
        } else {
          recommendBtn.innerHTML = '<i class="bi bi-hand-thumbs-up"></i> Recomende algo!';
          recommendBtn.style.width = '100%';
          recommendBtn.style.borderRadius = '12px';
          recommendBtn.style.padding = '20px';
        }
      }
    }

    function toggleFullscreen(button) {
      const card = button.closest('article');
      const overlay = document.getElementById('overlay');
      if (card.classList.contains('fullscreen')) {
        closeAllCards();
      } else {
        closeAllCards();
        card.classList.add('fullscreen');
        overlay.classList.add('active');
        button.textContent = 'Fechar';
        button.setAttribute('aria-label', 'Fechar');
        button.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeAllCards() {
      const cards = document.querySelectorAll('article.fullscreen');
      const overlay = document.getElementById('overlay');
      cards.forEach(card => {
        card.classList.remove('fullscreen');
        const btn = card.querySelector('.expand-btn');
        if (btn) {
          btn.textContent = '⤢';
          btn.setAttribute('aria-label', 'Ver mais detalhes');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
      overlay.classList.remove('active');
      document.body.style.overflow = 'auto';
    }
