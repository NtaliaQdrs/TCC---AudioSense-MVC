extends layout

block styles
  link(rel='stylesheet', href='/stylesheets/entretenimento.css')
  link(rel='stylesheet', href='/stylesheets/painelDenuncias.css')

block content

  main.page
    h1.title Entretenimento acessível

    section.cards-extra
      .main-grid

        if recomendacoes && recomendacoes.length
          each rec, index in recomendacoes
            article.extra-card1(data-categoria=rec.obra.tipo_obra)
              .card-inner
                if rec.obra.poster_url
                  img(src=rec.obra.poster_url alt="")
                else
                  .poster-placeholder
                    i.bi.bi-film

                .card-text
                  h2= rec.obra.titulo

                  //- Sinopse curta — visível no card fechado, some no fullscreen via CSS
                  p= rec.obra.sinopse

                  if rec.obra.data_lancamento
                    p.release-date
                      | Lançamento:
                      = new Date(rec.obra.data_lancamento).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })

                  //- Sinopse longa — visível só no fullscreen
                  .card-content(id=`card-content-${index}` aria-hidden="true")
                    p= rec.obra.sinopse

              //- Rodapé fora da coluna do texto: usa a largura inteira do card
              .card-footer
                .docente-info
                  if rec.docente && rec.docente.usuario
                    if rec.docente.usuario.foto_perfil
                      img.docente-foto(src=rec.docente.usuario.foto_perfil alt=rec.docente.usuario.nome_usuario)
                    else
                      img.docente-foto(src='/images/foto-perfil-default.png' alt="")
                    span.docente-nome Recomendado por @#{rec.docente.usuario.nome_usuario}

                .card-footer-actions
                  .platform
                    if rec.plataforma.logo_url
                      img.netflix-icon(
                        src=rec.plataforma.logo_url
                        alt=rec.plataforma.nome
                      )
                    span Acesse na #{rec.plataforma.nome}

                  button.btn-denunciar(
                    type="button"
                    aria-label=`Denunciar ${rec.obra.titulo}`
                    onclick=`abrirDenuncia('recomendacao', ${rec.id})`
                  )
                    i.bi.bi-flag(aria-hidden="true")
                    | Denunciar

                  button.expand-btn(
                    type="button"
                    onclick="toggleFullscreen(this)"
                    aria-label="Ver mais detalhes"
                    aria-expanded="false"
                    aria-controls=`card-content-${index}`
                  ) ⤢

        else
          p.sem-conteudo Nenhuma recomendação cadastrada ainda.

        div.right-column

          aside.sidebar(aria-labelledby="sidebar-title")
            h3#sidebar-title Filtrar por categoria

            div.filter-group(role="group" aria-labelledby="sidebar-title")
              button.btn-filter(
                type="button"
                aria-pressed="true"
                data-categoria="todos"
                onclick="filtrarCategoria('todos', this)"
              ) Todos
              button.btn-filter(
                type="button"
                aria-pressed="false"
                data-categoria="filme"
                onclick="filtrarCategoria('filme', this)"
              ) Filmes
              button.btn-filter(
                type="button"
                aria-pressed="false"
                data-categoria="serie"
                onclick="filtrarCategoria('serie', this)"
              ) Séries
              button.btn-filter(
                type="button"
                aria-pressed="false"
                data-categoria="documentario"
                onclick="filtrarCategoria('documentario', this)"
              ) Documentários
              button.btn-filter(
                type="button"
                aria-pressed="false"
                data-categoria="outro"
                onclick="filtrarCategoria('outro', this)"
              ) Outros

              span#filtro-status.sr-only(aria-live="polite" role="status")

            if usuario && (usuario.tipo_usuario === 'docente' || usuario.is_admin)
              button.recommend-btn(aria-label="Recomende algo!" onclick="window.location.href='/inserir-entretenimento'")
                i.bi.bi-hand-thumbs-up(aria-hidden="true")
                span   Recomende algo!

            button.toggle-sidebar(
              onclick="toggleSidebar()"
              aria-expanded="true"
              aria-label="Expandir ou recolher menu") ↑

  // Botão flutuante que abre/fecha a sidebar de filtros no mobile (fica fora
  // do .right-column/.sidebar, então não é afetado pelo transform dela)
  button.sidebar-fab(
    id="sidebarFab"
    type="button"
    aria-label="Abrir filtros"
    aria-expanded="false"
  )
    i.bi.bi-funnel(aria-hidden="true")

  #overlay.card-overlay(onclick="closeAllCards()")

  //- Modal de denúncia (compartilhado entre as telas)
  include partials/denuncia-modal

  script(src="/javascripts/entretenimento.js")
  script.
    const sidebarFab = document.getElementById('sidebarFab');
    const sidebarEl = document.querySelector('.sidebar');
    const sidebarOverlay = document.getElementById('overlay');

    // "Portal": move fab + overlay pro <body> (sempre) e a sidebar pro
    // <body> só em telas mobile — assim eles nunca ficam presos como
    // containing block de um ancestral com filter (modo daltônico),
    // preservando o position:fixed relativo à tela inteira.
    if (sidebarFab && sidebarFab.parentElement !== document.body) {
      document.body.appendChild(sidebarFab);
    }
    if (sidebarOverlay && sidebarOverlay.parentElement !== document.body) {
      document.body.appendChild(sidebarOverlay);
    }

    if (sidebarEl) {
      const sidebarPlaceholder = document.createElement('div');
      sidebarPlaceholder.style.display = 'none';
      sidebarEl.parentNode.insertBefore(sidebarPlaceholder, sidebarEl);

      (function () {
        function reposicionarSidebar() {
          const isMobile = window.innerWidth <= 900;
          if (isMobile && sidebarEl.parentElement !== document.body) {
            document.body.appendChild(sidebarEl);
          } else if (!isMobile && sidebarEl.parentElement === document.body) {
            sidebarPlaceholder.parentNode.insertBefore(sidebarEl, sidebarPlaceholder.nextSibling);
          }
        }
        reposicionarSidebar();
        window.addEventListener('resize', reposicionarSidebar);
      })();
    }

    if (sidebarFab && sidebarEl) {
      sidebarFab.addEventListener('click', () => {
        const isOpen = sidebarEl.classList.toggle('mobile-open');
        sidebarOverlay.classList.toggle('active', isOpen);
        sidebarFab.setAttribute('aria-expanded', isOpen);
      });

      sidebarOverlay.addEventListener('click', () => {
        sidebarEl.classList.remove('mobile-open');
        sidebarOverlay.classList.remove('active');
        sidebarFab.setAttribute('aria-expanded', 'false');
      });
    }

    let lastFocusedElement = null;
    let inertedElements = [];

    function getFocusableElements(container) {
      return Array.from(
        container.querySelectorAll(
          'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    function hideBackgroundExcept(card, overlay) {
      inertedElements = [];
      let node = card;
      while (node && node !== document.body) {
        const parent = node.parentElement;
        if (parent) {
          Array.from(parent.children).forEach(sibling => {
            if (sibling !== node && sibling !== overlay) {
              sibling.setAttribute('inert', '');
              inertedElements.push(sibling);
            }
          });
        }
        node = parent;
      }
    }

    function restoreBackground() {
      inertedElements.forEach(el => el.removeAttribute('inert'));
      inertedElements = [];
    }

    function toggleSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const button = document.querySelector('.toggle-sidebar');
      const grid = document.querySelector('.main-grid');
      const recommendBtn = document.querySelector('.recommend-btn');
      const isCollapsed = sidebar.classList.toggle('collapsed');
      grid.classList.toggle('sidebar-collapsed', isCollapsed);
      button.textContent = isCollapsed ? '↓' : '↑';
      button.setAttribute('aria-expanded', !isCollapsed);

      if (recommendBtn) {
        if (isCollapsed) {
          recommendBtn.innerHTML = '<i class="bi bi-hand-thumbs-up"></i>';
          recommendBtn.style.width = '40px';
          recommendBtn.style.borderRadius = '50%';
          recommendBtn.style.padding = '0';
        } else {
          recommendBtn.innerHTML = '<i class="bi bi-hand-thumbs-up"></i> Recomende algo!';
          recommendBtn.style.width = '100%';
          recommendBtn.style.borderRadius = '12px';
          recommendBtn.style.padding = '20px';
        }
      }
    }

    function toggleFullscreen(button) {
      const card = button.closest('article');
      const content = card.querySelector('.card-content');
      const overlay = document.getElementById('overlay');

      if (card.classList.contains('fullscreen')) {
        closeAllCards();
      } else {
        closeAllCards();

        lastFocusedElement = button;

        card.classList.add('fullscreen');
        overlay.classList.add('active');
        button.textContent = 'Fechar';
        button.setAttribute('aria-label', 'Fechar');
        button.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';

        card.setAttribute('role', 'dialog');
        card.setAttribute('aria-modal', 'true');
        card.setAttribute('tabindex', '-1');

        const titulo = card.querySelector('h2');
        if (titulo) {
          if (!titulo.id) titulo.id = 'titulo-dialog-' + Math.random().toString(36).slice(2);
          card.setAttribute('aria-labelledby', titulo.id);
        }

        if (content) {
          content.setAttribute('aria-hidden', 'false');
          if (!content.id) content.id = 'conteudo-dialog-' + Math.random().toString(36).slice(2);
          card.setAttribute('aria-describedby', content.id);
        }

        hideBackgroundExcept(card, overlay);
        card.focus();

        document.addEventListener('keydown', handleEscKey);
        document.addEventListener('keydown', handleTrapFocus);
      }
    }

    function handleTrapFocus(e) {
      if (e.key !== 'Tab') return;

      const card = document.querySelector('article.fullscreen');
      if (!card) return;

      const focusable = getFocusableElements(card);
      if (focusable.length === 0) {
        e.preventDefault();
        card.focus();
        return;
      }

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && (document.activeElement === first || document.activeElement === card)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function handleEscKey(e) {
      if (e.key === 'Escape') closeAllCards();
    }

    function closeAllCards() {
      const cards = document.querySelectorAll('article.fullscreen');
      const overlay = document.getElementById('overlay');

      cards.forEach(card => {
        card.classList.remove('fullscreen');
        const btn = card.querySelector('.expand-btn');
        const content = card.querySelector('.card-content');
        if (btn) {
          btn.textContent = '⤢';
          btn.setAttribute('aria-label', 'Ver mais detalhes');
          btn.setAttribute('aria-expanded', 'false');
        }
        if (content) content.setAttribute('aria-hidden', 'true');

        card.removeAttribute('role');
        card.removeAttribute('aria-modal');
        card.removeAttribute('aria-labelledby');
        card.removeAttribute('aria-describedby');
        card.removeAttribute('tabindex');
      });

      overlay.classList.remove('active');
      document.body.style.overflow = 'auto';

      restoreBackground();
      document.removeEventListener('keydown', handleEscKey);
      document.removeEventListener('keydown', handleTrapFocus);

      if (lastFocusedElement) {
        lastFocusedElement.focus();
        lastFocusedElement = null;
      }
    }
