extends layout

block styles
  link(rel="stylesheet", href="/stylesheets/biblioteca.css")
  link(rel="stylesheet", href="/stylesheets/painelDenuncias.css")

block content
  //- Matérias que realmente existem nos materiais listados (sem repetir)
  - const disciplinas = [...new Set(materiais.map(m => m.disciplinaNome).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'pt-BR'))

  main.page
    h1.title Biblioteca de materiais acessibilizados

    //- Barra de busca e botão de inserir
    .search-section
      .search-box
        i.bi.bi-search(aria-hidden="true")
        input(type="text" placeholder="Buscar por título, descrição ou disciplina" aria-label="Buscar materiais na biblioteca")

      if usuario && usuario.tipo_usuario === 'docente'
        a.btn-insert(href="/inserir-material" aria-label="Inserir novo conteúdo na biblioteca")
          i.bi.bi-plus(aria-hidden="true")
          |  Inserir conteúdo

    //- Filtros por matéria (um botão por matéria que existe na biblioteca)
    .filters-section(role="group" aria-label="Filtrar por matéria")
      button.filter-btn.active(type="button" data-filter="__todas__" aria-pressed="true") Todas as matérias
      each disciplina in disciplinas
        button.filter-btn(type="button" data-filter=disciplina aria-pressed="false")= disciplina

    //- Avisa leitores de tela quantos materiais ficaram na lista
    p#filtro-status.sr-only(role="status" aria-live="polite")

    //- Seção de materiais disponíveis
    .materials-section
      h2.materials-title
        | Materiais disponíveis (
        span#contagem-materiais= materiais.length
        | )

      if materiais.length === 0
        p Nenhum material disponível ainda.

      each material in materiais
        .material-card(data-href=`/material/${material.id}` data-disciplina=material.disciplinaNome)

          .card-icon(class=material.tipo_material === 'video' ? 'purple' : (material.tipo_material === 'artigo' ? 'blue' : ''))
            if material.tipo_material === 'video'
              i.bi.bi-play-circle-fill(aria-hidden="true")
            else if material.tipo_material === 'artigo'
              i.bi.bi-file-earmark-text-fill(aria-hidden="true")
            else if material.tipo_material === 'slide'
              i.bi.bi-file-slides-fill(aria-hidden="true")
            else
              i.bi.bi-folder-fill(aria-hidden="true")

          if material.capa
            .card-image
              img(
                src=material.capa
                alt=`Capa de ${material.titulo}`
              )

          .card-content

            h3.card-title
              a(href=`/material/${material.id}`)= material.titulo

            if material.descricao
              p.card-description= material.descricao

            .card-meta
              span.meta-item
                i.bi.bi-person(aria-hidden="true")
                | Prof. #{material.docenteNome}

              span.meta-item
                i.bi.bi-calendar(aria-hidden="true")
                | #{material.data_publicacao.toLocaleDateString('pt-BR')}

            .card-tags
              if material.disciplinaNome
                span.tag #{material.disciplinaNome}

              span.tag #{material.tipo_material}

            .card-rating(
              aria-label=material.media ? `Avaliação: ${material.media} de 5` : 'Sem avaliações'
            )
              if material.media
                i.bi.bi-star-fill(aria-hidden="true")
                span.rating-value #{material.media}
              else
                span.rating-value Sem avaliações

          //- Ações do card: denunciar (todos) + apagar (só quem pode)
          .card-actions
            button.btn-denunciar(
              type="button"
              aria-label=`Denunciar material: ${material.titulo}`
              onclick=`event.stopPropagation(); abrirDenuncia('material', ${material.id})`
            )
              i.bi.bi-flag(aria-hidden="true")
              |  Denunciar

            if material.podeApagar
              form.form-apagar-material(
                action=`/material/${material.id}/apagar`
                method="POST"
              )
                button.btn-delete-material(
                  type="submit"
                  aria-label=`Apagar material: ${material.titulo}`
                )
                  i.bi.bi-trash(aria-hidden="true")
                  | Apagar

      p#sem-resultados.sem-resultados(hidden) Nenhum material encontrado nesta matéria.

  //- Modal de denúncia (compartilhado entre as telas)
  include partials/denuncia-modal

  script(src="../javascripts/biblioteca.js")
  script.
    // ===== Filtro por matéria =====
    (function () {
      var secao = document.querySelector('.filters-section');
      if (!secao) return;

      var TODAS = '__todas__';
      var botoes = Array.prototype.slice.call(secao.querySelectorAll('.filter-btn'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('.material-card'));
      var contagem = document.getElementById('contagem-materiais');
      var semResultados = document.getElementById('sem-resultados');
      var status = document.getElementById('filtro-status');

      function filtrar(materia, atualizarEndereco) {
        var mostrarTodas = materia === TODAS;
        var visiveis = 0;

        cards.forEach(function (card) {
          var combina = mostrarTodas || card.getAttribute('data-disciplina') === materia;
          card.classList.toggle('oculto-filtro', !combina);
          if (combina) visiveis++;
        });

        botoes.forEach(function (botao) {
          var ativo = botao.getAttribute('data-filter') === materia;
          botao.classList.toggle('active', ativo);
          botao.setAttribute('aria-pressed', String(ativo));
        });

        if (contagem) contagem.textContent = visiveis;
        if (semResultados) semResultados.hidden = visiveis !== 0 || cards.length === 0;

        if (status) {
          status.textContent = mostrarTodas
            ? visiveis + (visiveis === 1 ? ' material exibido.' : ' materiais exibidos.')
            : visiveis + (visiveis === 1 ? ' material' : ' materiais') + ' em ' + materia + '.';
        }

        // Guarda a escolha no endereço, para sobreviver a F5 e ao botão Voltar
        if (atualizarEndereco && window.history && history.replaceState) {
          var url = new URL(window.location.href);
          if (mostrarTodas) url.searchParams.delete('materia');
          else url.searchParams.set('materia', materia);
          history.replaceState(null, '', url);
        }
      }

      botoes.forEach(function (botao) {
        botao.addEventListener('click', function () {
          filtrar(botao.getAttribute('data-filter'), true);
        });
      });

      // Se a página abriu com ?materia=Biologia, já aplica
      var inicial = new URLSearchParams(window.location.search).get('materia');
      var existe = botoes.some(function (b) { return b.getAttribute('data-filter') === inicial; });
      if (inicial && existe) filtrar(inicial, false);
    })();
