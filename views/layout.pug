doctype html 
html(lang="pt-BR")
  head
    title #{title}
    meta(charset="UTF-8")
    link(rel="icon" type="image/png" href="/images/boasvindas.png")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    script(src="/javascripts/theme-bootstrap.js")
    link(rel='stylesheet' href='/stylesheets/menu.css')
    link(rel='stylesheet' href='/stylesheets/fab.css')
    link(rel='stylesheet' href='/stylesheets/painelDenuncia.css')
    block styles
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap")
    link(rel="stylesheet" href="/stylesheets/accessibility.css")

  body

    header.top-bar
      .top-bar-content
        a.skip-link(href="#main-content") Pular para o conteúdo principal

        .logo
          a(href="/" aria-label="AudioSense - Página Inicial")
            img(src="/images/audiosense.png" alt="")

        button#categoryToggle.category-toggle(
          type="button"
          aria-label="Abrir menu de categorias" 
          aria-haspopup="true" 
          aria-expanded="false"
          aria-controls="categoryDropdown"
        )
          i.bi.bi-grid-3x3-gap-fill(aria-hidden="true")

        #categoryDropdown.category-dropdown(hidden)
          nav.category-links(aria-label="Categorias")
            a.dropdown-item(href="/") Início
            a.dropdown-item(href="/configuracoes") Configurações
            a.dropdown-item(href="/deficiencia-visual") Deficiência visual
            a.dropdown-item(href="/audiodescricao") Audiodescrição
            a.dropdown-item(href="/entretenimento") Entretenimento
            a.dropdown-item(href="/forum") Fórum
            a.dropdown-item(href="/biblioteca") Biblioteca

        

        nav.menu-links(aria-label="Menu Principal")
          a(href="/") Início
          a(href="/configuracoes") Configurações
          a(href="/sobre-nos") Sobre nós

        .menu-right
          form.search-box1(action="/buscar" method="get" role="search")
            i.bi.bi-search(aria-hidden="true")
            input(
              type="search"
              name="q"
              placeholder="Buscar tópicos, materiais..."
              aria-label="Buscar tópicos, materiais e obras no AudioSense"
              maxlength="100"
              required
            )
            button.search-submit(type="submit" aria-label="Pesquisar")
              i.bi.bi-arrow-return-left(aria-hidden="true")

          .profile-menu
            button#profileBtn.profile-button(
              type="button"
              aria-haspopup="true" 
              aria-expanded="false" 
              aria-controls="profileDropdown" 
              aria-label="Menu do perfil do usuário"
            )
              span Perfil 
              i#perfil-logo.bi.bi-person-circle(aria-hidden="true")
              span#badge-perfil.badge(style="display:none" aria-live="polite") 0

            #profileDropdown.profile-dropdown(hidden)

              .dropdown-tabs(role="tablist" aria-label="Perfil e notificações")
                button#tab-profile.tab-btn.tab-active(
                  type="button"
                  role="tab"
                  aria-selected="true"
                  aria-controls="profile-tab"
                  data-tab="profile"
                  aria-label="Perfil"
                  tabindex="0"
                )
                  i.bi.bi-person-circle(aria-hidden="true")

                button#tab-notifications.tab-btn(
                  type="button"
                  role="tab"
                  aria-selected="false"
                  aria-controls="notifications-tab"
                  data-tab="notifications"
                  aria-label="Notificações"
                  tabindex="-1"
                )
                  i.bi.bi-bell(aria-hidden="true")
                  span#badge-notificacoes.badge(style="display:none" aria-live="polite") 0

              .tab-pane.tab-pane-active#profile-tab(role="tabpanel" aria-labelledby="tab-profile" tabindex="0")

                a.dropdown-item(href="/usuario/perfil")
                  i.bi.bi-person(aria-hidden="true")
                  |   Meu Perfil

                a.dropdown-item(href="/usuario/configuracoes-perfil")
                  i.bi.bi-gear(aria-hidden="true")
                  |   Configurações

                a#minhasAudiodescricoes.dropdown-item(
                  href="/usuario/minhas-audiodescricoes"
                  style="display: none;"
                )
                  i.bi.bi-headphones(aria-hidden="true")
                  |   Minhas Audiodescrições

                a#meusMateriais.dropdown-item(
                  href="/usuario/meus-materiais"
                  style="display: none;"
                )
                  i.bi.bi-file-earmark(aria-hidden="true")
                  |   Meus Materiais

                a#adminPainel.dropdown-item(
                  href="/painelAdmin1"
                  onclick="irParaPainelAdmin(event)"
                )
                  i.bi.bi-shield-lock(aria-hidden="true")
                  |   Painel do Administrador

                a#adminModeracao.dropdown-item(href="/admin/moderacao" style="display: none;")
                  i.bi.bi-flag(aria-hidden="true")
                  |   Moderação de conteúdo

                hr.dropdown-divider

                a#logoutBtn.dropdown-item.logout(href="/usuario/logout")
                  i.bi.bi-box-arrow-right(aria-hidden="true")
                  |   Sair da conta

              .tab-pane#notifications-tab(role="tabpanel" aria-labelledby="tab-notifications" tabindex="0" hidden)
                p(style="padding: 15px; color: #666; font-size: 14px;") Sem novas notificações.
                hr.dropdown-divider
                p(style="padding: 0 15px 15px; color: #666; font-size: 12px;")
                  | As notificações disponíveis são exibidas aqui.

    section.sub-menu
      nav(aria-label="Navegação por conteúdo")
        a(href="/deficiencia-visual") Deficiência visual
        a(href="/audiodescricao") Audiodescrição
        a(href="/entretenimento") Entretenimento
        a(href="/forum") Fórum
        a(href="/biblioteca") Biblioteca

    include partials/fab

    

    main#main-content(tabindex="-1")
      block content

    footer.footer
      .footer-container

        .footer-column
          h3
            i.bi.bi-headphones(aria-hidden="true")
            |  Sobre AudioSense
          p
            | AudioSense é uma plataforma sobre audiodescrição e deficiência visual.
            | Oferecemos recursos para profissionais especializados,
            | educadores e estudantes que desejam compartilhar e aprimorar
            | seus conhecimentos na área da acessibilidade.

        .footer-column
          h3
            i.bi.bi-link-45deg(aria-hidden="true")
            |  Links úteis
          ul
            li
              a(href="/sobre-nos") Sobre nós
            li
              a(href="/forum") Fórum
            li
              a(href="/biblioteca") Biblioteca
            li
              a(href="/configuracoes") Configurações de acessibilidade

        .footer-column
          h3
            i.bi.bi-envelope(aria-hidden="true")
            |  Entre em contato
          ul
            li
              i.bi.bi-envelope(aria-hidden="true")
              a(href="mailto:contato.audiosense@gmail.com") contato.audiosense@gmail.com
            li
              i.bi.bi-geo-alt(aria-hidden="true")
              |  Sombrio, SC - Brasil

        .footer-column
          h3
            i.bi.bi-share(aria-hidden="true")
            |  Redes Sociais
          p Os canais oficiais da AudioSense ainda não foram informados.

      .footer-bottom
        p
          | © #{new Date().getFullYear()} AudioSense. Desenvolvido pelo projeto AudioSense.

    script.
      const usuarioLogado = !{JSON.stringify(usuarioLogado)};

    script(src="/javascripts/menu.js")
    script(src="/javascripts/accessibility.js")
    script(src="/javascripts/fab.js")

  

  block scripts
