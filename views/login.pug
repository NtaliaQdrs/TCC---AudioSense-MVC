doctype html
html(lang="pt-br")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="icon" type="image/png" href="/images/boasvindas.png")
    title Login
    script(src="/javascripts/theme-bootstrap.js")
    link(rel="stylesheet" href="/stylesheets/loginEcadastro.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap")

  body
    .container
      .saudacao
        
        //- Logo para tema CLARO
        img.logo.logo-light(src="../images/audiosense-login.png" alt="Logo AudioSense")
        //- Logo para tema ESCURO
        img.logo.logo-dark(src="../images/audiosense-login-dark.png" alt="Logo AudioSense")
        
        h1 Bem vindo(a) de volta ao AudioSense!

      if erro === 'credenciais'
        .alert-rejeitado(role="alert")
          i.bi.bi-x-circle-fill(aria-hidden="true")
          | Email ou senha incorretos. Tente novamente.

      if erro === 'email'
        .alert-rejeitado
          i.bi.bi-x-circle-fill(aria-hidden="true")
          | Este email já está cadastrado.

      if erro === 'disciplina'
        .alert-rejeitado
          i.bi.bi-x-circle-fill(aria-hidden="true")
          | Selecione pelo menos uma disciplina.

      if erro === 'oauth_indisponivel'
        .alert-rejeitado(role="alert") O login social ainda não foi configurado nesta instalação.
      if erro === 'oauth_cancelado'
        .alert-rejeitado(role="alert") A autorização foi cancelada. Tente novamente.
      if erro === 'oauth_invalido'
        .alert-rejeitado(role="alert") A solicitação expirou ou não pôde ser validada. Tente novamente.
      if erro === 'oauth_email_nao_verificado'
        .alert-rejeitado(role="alert") O provedor não forneceu um e-mail válido para continuar.
      if erro === 'oauth_dados_invalidos'
        .alert-rejeitado(role="alert") Os dados do perfil social não podem ser usados nesta conta.
      if erro === 'oauth_email_existente'
        .alert-rejeitado(role="alert") Já existe uma conta com esse e-mail. Entre com sua senha; por segurança, contas não são vinculadas automaticamente.
      if erro === 'oauth_sem_conta'
        .alert-pendente(role="status")
          | Não existe uma conta social vinculada. Para criar uma conta discente, use a opção de cadastro com Google ou Facebook.
      if erro === 'oauth_conta_indisponivel'
        .alert-rejeitado(role="alert") Esta conta está desativada ou banida.
      if erro === 'oauth_erro'
        .alert-rejeitado(role="alert") Não foi possível concluir o acesso social. Tente novamente mais tarde.
          
      if status === 'pendente'
        .alert-pendente
          i.bi.bi-clock-fill(aria-hidden="true")
          | Seu cadastro está aguardando aprovação do administrador.

      if status === 'rejeitado'
        .alert-rejeitado
          i.bi.bi-x-circle-fill(aria-hidden="true")
          | Seu cadastro foi rejeitado.
          if motivo
            p.motivo= motivo
          a(href=`/usuario/cadastro-docente?email=${email}`) Tentar novamente

      if status === 'senha_redefinida'
        .alert-pendente
          i.bi.bi-check-circle-fill(aria-hidden="true")
          | Senha redefinida com sucesso! Faça login com sua nova senha.

      .social-login
        a.btn-social(href="/usuario/oauth/google?flow=login" aria-label="Entrar com Google")
          i.bi.bi-google(aria-hidden="true")
          | Entrar com Google
        a.btn-social(href="/usuario/oauth/facebook?flow=login" aria-label="Entrar com Facebook")
          i.bi.bi-facebook(aria-hidden="true")
          | Entrar com Facebook

      .divider
        span ou

      form(action="/usuario/login" method="POST" aria-label="Formulário de Login")
        .input-group
          i.bi.bi-envelope-fill(aria-hidden="true")
          .input-content
            label(for="email") Email
            input#email(type="email" name="email" placeholder="exemplo@gmail.com" required aria-required="true")

        .input-group
          i.bi.bi-key-fill(aria-hidden="true")
          .input-content
            label(for="senha") Senha
            input#senha(type="password" name="senha" placeholder="••••••••••" required)
          button.btn-toggle-password(type="button" onclick="togglePassword('senha', this)" aria-label="Mostrar senha" style="background: none; border: none; cursor: pointer;")
            i.bi.bi-eye.toggle-password(aria-hidden="true")

        .options
          label
            input(type="checkbox" name="manterConectado" style="accent-color: #2eb086;")
            |  Manter conectado
          a(href="/usuario/esqueceu-senha" aria-label="Recuperar senha esquecida") Esqueceu a senha?

        button.btn-submit(type="submit") Entrar
        button#btn-cancel.btn-cancel(type="reset") Cancelar

      p.footer-text
        | Não possui uma conta?
        a(href="/usuario/cadastro")  Cadastre-se

      p.footer-text
        a(href="/") Voltar para o início

    script(src="../javascripts/login.js")
    script(src="/javascripts/accessibility.js")