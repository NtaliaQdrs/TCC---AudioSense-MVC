doctype html
html(lang="pt-br")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="icon" type="image/png" href="/images/boasvindas.png")
    title cadastro de discente
    script(src="/javascripts/theme-bootstrap.js")
    link(rel="stylesheet" href="/stylesheets/loginEcadastro.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap")

  body
    .container
      .saudacao
     
        //- Logo para tema CLARO
        img.logo.logo-light(src="../images/audiosense-login.png" alt="Logo AudioSense")
        //- Logo para tema ESCURO
        img.logo.logo-dark(src="../images/audiosense-login-dark.png" alt="Logo AudioSense")
        h1 Bem vindo(a) ao AudioSense!

      .social-login
        p Cadastro por Google ou Facebook não está disponível.

      .divider
        span ou

      .cad
        form(action="/usuario/cadastro-discente" method="POST" aria-label="Formulário de Cadastro de Discente")
          .input-group
            i.bi.bi-person-fill(aria-hidden="true")
            .input-content
              label(for="nome_completo") Nome completo
              input#nome_completo(type="text" name="nome_completo" placeholder="Nome completo aqui" required)

          .input-group
            i.bi.bi-envelope-fill(aria-hidden="true")
            .input-content
              label(for="email") Email
              input#email(type="email" name="email" placeholder="Exemplo@gmail.com" required)

          .input-group
            i.bi.bi-key-fill(aria-hidden="true")
            .input-content
              label(for="senha") Senha
              input#senha(type="password" name="senha" placeholder="••••••••••" required)
            button.btn-toggle-password(type="button" onclick="togglePassword('senha', this)" aria-label="Mostrar senha" style="background: none; border: none; cursor: pointer;")
              i.bi.bi-eye.toggle-password(aria-hidden="true")

          .input-group
            i.bi.bi-key-fill(aria-hidden="true")
            .input-content
              label(for="confirmSenha") Confirme a senha
              input#confirmSenha(type="password" name="confirmSenha" placeholder="••••••••••" required)
            button.btn-toggle-password(type="button" onclick="togglePassword('confirmSenha', this)" aria-label="Mostrar confirmação de senha" style="background: none; border: none; cursor: pointer;")
              i.bi.bi-eye.toggle-password(aria-hidden="true")
          .options

          button.btn-submit(type="submit") Cadastre-se
          button#btn-cancel.btn-cancel(type="reset") Cancelar

          p.footer-text
            | Já possui uma conta? 
            a(href="/usuario") Faça login

          p.footer-text
            a(href="/") Voltar para o início


    script(src="../javascripts/cadastro.js")
    script(src="/javascripts/accessibility.js")