extends layout

block styles
  link(rel='stylesheet', href='/stylesheets/inserirAudiodescricao.css')
  link(rel='stylesheet', href='/stylesheets/audiodescricao.css')

block content
  .page
    h1.title= projeto.tipo_midia === 'video' ? 'Enviar Vídeo Final' : 'Enviar Áudio Final'

    section.container-form
      h2.form-title= projeto.tipo_midia === 'video' ? 'Envie o vídeo com a audiodescrição embutida' : 'Envie o áudio da sua audiodescrição'

      .form-group
        .projeto-resumo
          .projeto-resumo-info
            span.projeto-resumo-label Projeto
            h2.projeto-resumo-titulo= projeto.titulo

          if projeto.imagem_url
            img.projeto-resumo-img(
              src=projeto.imagem_url
              alt=projeto.titulo)
          else
            .projeto-resumo-placeholder
              i.bi.bi-film(aria-hidden="true")

      form(action=`/enviar-midia-final/${projeto.id}` method="POST" enctype="multipart/form-data")
        .form-group
          label.form-group-label(for="midia-final")= projeto.tipo_midia === 'video' ? 'Arquivo de vídeo' : 'Arquivo de áudio'
          label.upload-area(for="midia-final")
            i.bi.bi-cloud-arrow-up(style="font-size: 48px; color: #582d86;" aria-hidden="true")
            .upload-text
              if projeto.tipo_midia === 'video'
                p Clique para selecionar o arquivo de vídeo
                p(style="font-size:14px; color:#999") Formatos aceitos: MP4, WEBM
              else
                p Clique para selecionar o arquivo de áudio
                p(style="font-size:14px; color:#999") Formatos aceitos: MP3, WAV, OGG
            span.btn-upload Selecionar arquivo

          if projeto.tipo_midia === 'video'
            input#midia-final.sr-only-file(type="file" name="midia" accept="video/mp4,video/webm" required aria-describedby="nome-arquivo")
          else
            input#midia-final.sr-only-file(type="file" name="audio" accept="audio/*" required aria-describedby="nome-arquivo")

          p#nome-arquivo(style="margin-top:10px; color:#2eb086; font-weight:600" aria-live="polite")

        .button-group
          button.btn-submit(type="submit")= projeto.tipo_midia === 'video' ? 'Enviar vídeo' : 'Enviar áudio'
          a.btn-cancel(href="/audiodescricao") Cancelar

  script.
    document.getElementById('midia-final').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const label = document.getElementById('nome-arquivo');
      label.textContent = 'Arquivo selecionado: ' + file.name;
    });