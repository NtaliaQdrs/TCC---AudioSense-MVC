extends layout

block styles
  link(rel='stylesheet', href='/stylesheets/forum.css')

block content

  main.page
    .forum-header
      h1.title Fórum: Interaja e compartilhe
      .view-options
        i.bi.bi-grid-fill#btn-grid(style="cursor:pointer")
        i.bi.bi-list#btn-list(style="cursor:pointer")

    section.forum-container
      .forum-posts
        article.post-card
          .post-user
            img.avatar(src="/images/foto-perfil-default.png" alt="Foto de perfil")
            .user-info
              span.name Fulano de tal
              br
              span.date 21 de setembro
          .post-content
            h3 Logística de Audiodescrição em Eventos ao Vivo
            p A audiodescrição em eventos ao vivo (teatro, shows) é um desafio logístico, pois é em tempo real.
            p Quem tem experiência nisso? Quais são os maiores desafios técnicos (equipamento, latência) e de roteiro (improvisação)? Um checklist básico de equipamentos seria ótimo!
            img(src="../images/exemplo-forum.png")
            br
          .post-actions
            span
              i.bi.bi-chat-left
              | 2
            span
              i.bi.bi-heart
              | 5

        article.post-card
          .post-user
            img.avatar(src="/images/foto-perfil-default.png" alt="Foto de perfil")
            .user-info
              span.name Fulano de tal
              br
              span.date 21 de setembro
          .post-content
            h3 Desafios e Soluções na Audiodescrição de Filmes de Ação
            p Pessoal, estou audiodescrevendo um filme de ação e o tempo é curtíssimo! Como descrever a intensidade de uma perseguição sem atropelar o áudio original?
            p Minha dúvida é: focar no movimento ou na emoção da cena? Quais técnicas vocês usam para ser concisos em cenas rápidas? Compartilhem suas dicas de roteirização!
            br
          .post-actions
            span
              i.bi.bi-chat-left
              | 2
            span
              i.bi.bi-heart
              | 5

        article.post-card
          .post-user
            img.avatar(src="/images/foto-perfil-default.png" alt="Foto de perfil")
            .user-info
              span.name Fulano de tal
              br
              span.date 21 de setembro
          .post-content
            h3  A Voz Perfeita para Audiodescrição
            p  Como produtor de áudio, sei que a voz do narrador é crucial. Uma boa entonação transforma a experiência. Mas qual o critério ideal?
            p Vocês preferem vozes neutras e informativas, ou aquelas que transmitem um pouco da emoção da cena? Quais dicas de gravação para garantir uma voz de alta qualidade em um home studio?
            br
          .post-actions
            span
              i.bi.bi-chat-left
              | 2
            span
              i.bi.bi-heart
              | 5

        article.post-card
          .post-user
            img.avatar(src="/images/foto-perfil-default.png" alt="Foto de perfil")
            .user-info
              span.name Fulano de tal
              br
              span.date 21 de setembro
          .post-content
            h3 Meu Setup de Produção Minimalista
            p Finalmente organizei meu pequeno canto de produção! Não é muito, mas consigo criar bastante coisa com ele. O que acharam? Compartilhem seus setups também!
            br
          .post-actions
            span
              i.bi.bi-chat-left
              | 2
            span
              i.bi.bi-heart
              | 5

      //- Barra Lateral (Sidebar)
      aside.forum-sidebar
        //- Caixa branca com os filtros
        .sidebar-box
          button.btn-filter Recentes
          button.btn-filter Populares
          br
          button.toggle-sidebar( 
                onclick="toggleSidebar()" 
                aria-expanded="true" aria-label="Expandir ou recolher menu" ) ↑
          a.btn-criar-post(href="/inserir-topico")
            i.bi.bi-pencil
            span.btn-criar-texto  Criar post
          

    script(src="/javascripts/forum.js")
    script.
      function toggleSidebar() {
          const sidebarBox = document.querySelector('.sidebar-box');
          const forumSidebar = document.querySelector('.forum-sidebar');
          const button = document.querySelector('.toggle-sidebar');
          const forumPosts = document.querySelector('.forum-posts');
          const btnCriar = document.querySelector('.btn-criar-post');
          const isCollapsed = sidebarBox.classList.toggle('collapsed');
          forumSidebar.classList.toggle('collapsed', isCollapsed);

          button.textContent = isCollapsed ? '↓' : '↑';
          button.setAttribute('aria-expanded', !isCollapsed);

          document.querySelectorAll('.btn-filter, .sidebar-box br').forEach(el => {
              el.style.display = isCollapsed ? 'none' : '';
          });

          if (isCollapsed) {
              btnCriar.innerHTML = '<i class="bi bi-pencil"></i>';
              btnCriar.style.width = '40px';
              btnCriar.style.height = '40px';
              btnCriar.style.borderRadius = '50%';
              btnCriar.style.padding = '0';
              btnCriar.style.justifyContent = 'center';
          } else {
              btnCriar.innerHTML = '<i class="bi bi-pencil"></i><span>  Criar post</span>';
              btnCriar.style.width = '100%';
              btnCriar.style.height = 'auto';
              btnCriar.style.borderRadius = '12px';
              btnCriar.style.padding = '15px';
              btnCriar.style.justifyContent = 'center';
          }

          forumPosts.style.flex = isCollapsed ? '1' : '2';
      }