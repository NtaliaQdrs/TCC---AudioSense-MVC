extends layout

block styles
  link(rel="stylesheet", href="/stylesheets/deficienciaVisual.css")
  

block content
  main.page(role="main")

    // Título principal
    h1.title Entendendo a deficiência visual

    .content-wrapper
      // Conteúdo principal (cards)
      .main-content

        article.card
          .card-header
            img(src="../images/cegueira.png" alt="")
            h2#titulo-cegueira O que é cegueira?
          p.card-text#texto-cegueira
            | De acordo com o Decreto nº 5.296/2004, a cegueira é caracterizada pela acuidade visual igual ou menor que 0,05 no melhor olho, mesmo com a melhor correção óptica, ou campo visual somado igual ou menor que 60°. No contexto pedagógico, isso leva o estudante a utilizar o Sistema Braille, recursos táteis e tecnologias assistivas como principal via de acesso ao conteúdo, tendo na audiodescrição um recurso essencial de comunicação escrita e sonora.
          button.toggle-card(
            type="button"
            onclick="toggleFullscreen(this)"
            aria-expanded="false"
            aria-controls="texto-cegueira"
          ) Ler mais

        article.card
          .card-header
            img(src="../images/visaobaixa.png" alt="")
            h2 O que é baixa visão?
          p.card-text#texto-baixavisao
            | De acordo com o Decreto nº 5.296/2004, a baixa visão é caracterizada pela acuidade visual entre 0,3 e 0,05 no melhor olho, mesmo com a melhor correção óptica. No contexto pedagógico, o estudante com baixa visão utiliza tipos ampliados, alto contraste e instrumentos ópticos potentes como principal via de acesso ao conteúdo, tendo na audiodescrição um recurso complementar de comunicação escrita e sonora.
          button.toggle-card(
            type="button"
            onclick="toggleFullscreen(this)"
            aria-expanded="false"
            aria-controls="texto-baixavisao"
          ) Ler mais

        article.card
          .card-header
            img(src="../images/auxilio.png" alt="")
            h2 Como interagir e guiar pessoas com deficiência visual
          p.card-text#texto-auxilio
            | Ao interagir com pessoas com deficiência visual, é importante perguntar se elas precisam de ajuda antes de oferecer. 
            | Caso precise guiar alguém, deixe que a pessoa segure o seu braço, em vez de puxá-la. 
            | Identifique-se antes de iniciar uma conversa e descreva o ambiente com clareza. 
            | Mantenha sempre uma comunicação respeitosa e clara. 
          button.toggle-card(
            type="button"
            onclick="toggleFullscreen(this)"
            aria-expanded="false"
            aria-controls="texto-auxilio"
          ) Ler mais

      // Sidebar
      aside.sidebar(aria-labelledby="sidebar-title")
        h3#sidebar-title Sugestão de conteúdo adicional

        nav(aria-label="Links complementares")
          ul(style="list-style: none; padding: 0;")
            li
              .sidebar-item
                i.bi.bi-file-earmark-text(aria-hidden="true")
                small.text Artigos
              ul.sidebar-links(style="list-style: none; padding: 0; margin: 6px 0 0;")
                li
                  a(href="https://www.scielo.br/j/edreal/a/ShdbzbdgyXYwcqzT74Lpx9D/" target="_blank" rel="noopener" aria-label="Política de Acessibilidade: o que dizem as pessoas com deficiência visual (abre em nova aba)")
                    | Política de Acessibilidade (SciELO)
                li
                  a(href="https://www.cartacapital.com.br/bem-estar/5-recursos-de-acessibilidade-para-pessoas-com-deficiencia-visual/" target="_blank" rel="noopener" aria-label="5 recursos de acessibilidade para pessoas com deficiência visual, CartaCapital (abre em nova aba)")
                    | 5 recursos de acessibilidade (CartaCapital)
            hr

            li
              .sidebar-item
                i.bi.bi-play-btn(aria-hidden="true")
                small.text Vídeos educacionais
              ul.sidebar-links(style="list-style: none; padding: 0; margin: 6px 0 0;")
                li
                  a(href="https://www.youtube.com/@HistoriasdeCego" target="_blank" rel="noopener" aria-label="Canal Histórias de Cego no YouTube (abre em nova aba)")
                    | Canal "Histórias de Cego"
            hr

            li
              .sidebar-item
                i.bi.bi-people(aria-hidden="true")
                small.text Relatos
              ul.sidebar-links(style="list-style: none; padding: 0; margin: 6px 0 0;")
                li
                  a(href="https://www.catarse.com.br/posts/entrevista-conheca-marcos-lima-58978" target="_blank" rel="noopener" aria-label="Entrevista com Marcos Lima, criador do canal Histórias de Cego (abre em nova aba)")
                    | Entrevista com Marcos Lima
                li
                  a(href="https://agenciaeconordeste.com.br/sustentabilidade/a-deficiencia-visual-e-o-desafio-da-acessibilidade-no-mundo-real/" target="_blank" rel="noopener" aria-label="Relato de Rafael, estudante universitário cego (abre em nova aba)")
                    | Relato de Rafael, estudante cego
            hr


        button.toggle-sidebar(
          onclick="toggleSidebar()"
          aria-expanded="true"
          aria-label="Expandir ou recolher menu"
        ) ↑

  // Overlay para fechar o card expandido clicando fora
  #overlay.card-overlay(onclick="closeAllCards()" aria-hidden="true")

  script.
    let lastFocusedElement = null;

    function toggleSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const wrapper = document.querySelector('.content-wrapper');
      const button = document.querySelector('.toggle-sidebar');

      const isCollapsed = sidebar.classList.toggle('collapsed');
      wrapper.classList.toggle('sidebar-collapsed');

      button.textContent = isCollapsed ? '↓' : '↑';
      button.setAttribute('aria-expanded', !isCollapsed);
    }

    function getTargetRect() {
      const width = Math.min(window.innerWidth * 0.9, 800);
      const height = Math.min(window.innerHeight * 0.8, 600);
      const top = window.innerHeight / 2 + 50 - height / 2;
      const left = window.innerWidth / 2 - width / 2;
      return { top, left, width, height };
    }

    function getFocusableElements(container) {
      return Array.from(
        container.querySelectorAll(
          'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    function toggleFullscreen(button) {
      const card = button.closest('article');
      const overlay = document.getElementById('overlay');

      if (card.classList.contains('fullscreen')) {
        closeAllCards();
      } else {
        closeAllCards();

        lastFocusedElement = button;

        const startRect = card.getBoundingClientRect();

        const placeholder = document.createElement('div');
        placeholder.className = 'card-placeholder';
        placeholder.style.width = startRect.width + 'px';
        placeholder.style.height = startRect.height + 'px';
        placeholder.style.margin = window.getComputedStyle(card).margin;
        placeholder.id = 'placeholder-' + Math.random().toString(36).slice(2);
        card.parentNode.insertBefore(placeholder, card);
        card.dataset.placeholderId = placeholder.id;

        document.body.appendChild(card);
        card.style.position = 'fixed';
        card.style.top = startRect.top + 'px';
        card.style.left = startRect.left + 'px';
        card.style.width = startRect.width + 'px';
        card.style.height = startRect.height + 'px';
        card.style.transition = 'none';

        document.body.appendChild(overlay);
        card.setAttribute('role', 'dialog');
        card.setAttribute('aria-modal', 'true');
        card.setAttribute('tabindex', '-1');

        const titulo = card.querySelector('h2');
        if (titulo) {
          if (!titulo.id) titulo.id = 'titulo-dialog-' + Math.random().toString(36).slice(2);
          card.setAttribute('aria-labelledby', titulo.id);
        }

        const texto = card.querySelector('.card-text');
        if (texto) {
          if (!texto.id) texto.id = 'texto-dialog-' + Math.random().toString(36).slice(2);
          card.setAttribute('aria-describedby', texto.id);
        }

        Array.from(document.body.children).forEach(el => {
          if (el !== card && el !== overlay) el.setAttribute('inert', '');
        });

        void card.offsetHeight;

        requestAnimationFrame(() => {
          card.style.transition = '';
          card.classList.add('fullscreen');
          overlay.classList.add('active');

          const target = getTargetRect();
          card.style.top = target.top + 'px';
          card.style.left = target.left + 'px';
          card.style.width = target.width + 'px';
          card.style.height = target.height + 'px';

          requestAnimationFrame(() => {
            overlay.classList.add('show');
          });

          button.textContent = 'Fechar';
          button.setAttribute('aria-expanded', 'true');

          // Foca o card (não o botão direto) pra o leitor de tela anunciar
          // título + descrição antes do usuário chegar no "Fechar"
          card.focus();
        });

        document.addEventListener('keydown', handleEscKey);
        document.addEventListener('keydown', handleTrapFocus);
      }
    }

    function handleTrapFocus(e) {
      if (e.key !== 'Tab') return;

      const card = document.querySelector('article.fullscreen');
      if (!card) return;

      const focusable = getFocusableElements(card);
      if (focusable.length === 0) {
        e.preventDefault();
        card.focus();
        return;
      }

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && (document.activeElement === first || document.activeElement === card)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function closeAllCards() {
      const cards = document.querySelectorAll('article.fullscreen');
      const overlay = document.getElementById('overlay');

      cards.forEach(card => {
        const placeholder = document.getElementById(card.dataset.placeholderId);
        if (!placeholder) return;

        const endRect = placeholder.getBoundingClientRect();
        overlay.classList.remove('show');

        card.style.top = endRect.top + 'px';
        card.style.left = endRect.left + 'px';
        card.style.width = endRect.width + 'px';
        card.style.height = endRect.height + 'px';

        const btn = card.querySelector('.toggle-card');
        if (btn) {
          btn.textContent = 'Ler mais';
          btn.setAttribute('aria-expanded', 'false');
        }

        setTimeout(() => {
          card.classList.remove('fullscreen');
          card.removeAttribute('role');
          card.removeAttribute('aria-modal');
          card.removeAttribute('aria-labelledby');
          card.removeAttribute('aria-describedby');
          card.removeAttribute('tabindex');
          card.style.position = '';
          card.style.top = '';
          card.style.left = '';
          card.style.width = '';
          card.style.height = '';

          placeholder.parentNode.insertBefore(card, placeholder);
          placeholder.remove();
          delete card.dataset.placeholderId;

          if (lastFocusedElement) {
            lastFocusedElement.focus();
            lastFocusedElement = null;
          }
        }, 400);
      });

      overlay.classList.remove('active');
      document.body.style.overflow = 'auto';

      Array.from(document.body.children).forEach(el => el.removeAttribute('inert'));
      document.removeEventListener('keydown', handleEscKey);
      document.removeEventListener('keydown', handleTrapFocus);
    }

    function handleEscKey(e) {
      if (e.key === 'Escape') closeAllCards();
    }