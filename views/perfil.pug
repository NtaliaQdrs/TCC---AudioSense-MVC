extends layout

block styles
  link(rel='stylesheet' href='/stylesheets/perfil.css')

block content
  .perfil-container
    //- CABEÇALHO DO PERFIL
    .perfil-header
      .perfil-header-content
        .perfil-avatar-section
          .perfil-avatar
            img(src= usuario.foto_perfil ? usuario.foto_perfil : '/images/foto-perfil-default.png' alt="Avatar do usuário")

          
          if is_admin 
            .avatar-badge(aria-label="Administrador")
              img(src="/images/docenteadmin.png" width="20" alt="")

          else if usuario.tipo_usuario === 'docente'
            .avatar-badge(aria-label="Docente")
              img(src="/images/docente.png" width="20" alt="")
          else
            .avatar-badge(aria-label="Discente")
              img(src="/images/discente.png" width="20" alt="")

        .perfil-info
          .perfil-info-header
            h1.perfil-name= usuario.nome_completo
            p.perfil-username= '@' + usuario.nome_usuario
          
          p.perfil-bio= usuario.biografia || 'Nenhuma biografia cadastrada.'
          if usuario.tipo_usuario === 'docente' && disciplinas.length > 0
            .perfil-disciplinas
              each disciplina in disciplinas
                span.disciplina-tag= disciplina.titulo

          .perfil-details
            .perfil-detail-item
              i.bi.bi-envelope-fill(aria-hidden="true")
              span= usuario.email

            .perfil-detail-item
              i.bi.bi-calendar-event(aria-hidden="true")
              span= 'Membro desde: ' + membroDesde

        .perfil-actions
          button.btn-editar-perfil(aria-label="Editar perfil")
            i.bi.bi-pencil(aria-hidden="true")
            span Editar perfil

    //- ESTATÍSTICAS
    .perfil-stats
      if usuario.tipo_usuario === 'docente'
        .stat-card
          .stat-icon
            i.bi.bi-volume-up(aria-hidden="true")
          .stat-content
            .stat-number= audiodescricoes.length
            .stat-label Audiodescrições corrigidas
      else
        .stat-card
          .stat-icon
            i.bi.bi-volume-up(aria-hidden="true")
          .stat-content
            .stat-number= audiodescricoes.length
            .stat-label Audiodescrições criadas

      .stat-card
        .stat-icon
          i.bi.bi-chat-dots(aria-hidden="true")
        .stat-content
          .stat-number= postagensForum.length
          .stat-label Postagens no fórum

      if usuario.tipo_usuario === 'docente'
        .stat-card
          .stat-icon
            i.bi.bi-book(aria-hidden="true")
          .stat-content
            .stat-number= materiais.length
            .stat-label Materiais compartilhados

        .stat-card
          .stat-icon
            i.bi.bi-hand-thumbs-up(aria-hidden="true")
          .stat-content
            .stat-number 0
            .stat-label Curtidas recebidas

    //- ABAS DE CONTEÚDO
    .perfil-tabs
      .tabs-header(role="tablist" aria-label="Conteúdo do perfil")
        if usuario.tipo_usuario === 'docente'
          button#tab-btn-audiodescricoes.tab-btn.active(
            role="tab"
            data-tab="audiodescricoes"
            aria-selected="true"
            aria-controls="tab-audiodescricoes"
          )
            i.bi.bi-volume-up(aria-hidden="true")
            span Audiodescrições corrigidas
        else
          button#tab-btn-audiodescricoes.tab-btn.active(
            role="tab"
            data-tab="audiodescricoes"
            aria-selected="true"
            aria-controls="tab-audiodescricoes"
          )
            i.bi.bi-volume-up(aria-hidden="true")
            span Audiodescrições

        button#tab-btn-forum.tab-btn(
          role="tab"
          data-tab="forum"
          aria-selected="false"
          aria-controls="tab-forum"
        )
          i.bi.bi-chat-left-text(aria-hidden="true")
          span Fórum

        if usuario.tipo_usuario === 'docente'
          button#tab-btn-materiais.tab-btn(
            role="tab"
            data-tab="materiais"
            aria-selected="false"
            aria-controls="tab-materiais"
          )
            i.bi.bi-file-earmark-pdf(aria-hidden="true")
            span Materiais

      //- TAB: AUDIODESCRIÇÕES
      .tab-content#tab-audiodescricoes.tab-pane.active(role="tabpanel" aria-labelledby="tab-btn-audiodescricoes")
        .audiodescricoes-list
          if audiodescricoes.length === 0
            p(style="color:#6B7280; padding: 20px") Nenhuma audiodescrição encontrada.
          each item in audiodescricoes
            .audiodescricao-item
              .item-icon
                i.bi.bi-film(aria-hidden="true")
              .item-content
                h3.item-title= item.titulo
                p.item-description= item.descricao
              .item-meta
                span.item-date
                  i.bi.bi-calendar
                  |  #{new Date(item.data_submissao).toLocaleDateString('pt-BR')}
                span.status-badge= item.status
                if usuario.tipo_usuario !== 'docente'
                  if item.status === 'aprovado'
                    a.btn-ver(href='/enviar-audio/' + item.id) Enviar áudio
                  else if item.status === 'requer_ajustes'
                    a.btn-ver(href='/ajustar-audiodescricao/' + item.id) Ajustar
                  else if item.status === 'concluido'
                    a.btn-ver(href='/ver-audiodescricao/' + item.id) Ver
                  else
                    span.btn-ver-disabled Em análise
        .view-all-link
          a(href="/usuario/minhas-audiodescricoes" aria-label="Ver todas as audiodescrições") Ver todas

      //- TAB: FÓRUM
      .tab-content#tab-forum.tab-pane(role="tabpanel" aria-labelledby="tab-btn-forum" hidden)
        .forum-list
          if postagensForum.length === 0
            p(style="color:#6B7280; padding: 20px") Você ainda não postou no fórum.
          each topico in postagensForum
            a.forum-item(href=`/forum/${topico.id}` style="text-decoration:none; color:inherit;")
              .forum-icon
                i.bi.bi-chat-dots(aria-hidden="true")
              .forum-content
                h3.forum-title= topico.titulo
                p.forum-description= topico.corpo_texto_curto
                .forum-meta
                  span.forum-replies
                    i.bi.bi-chat-left(aria-hidden="true")
                    |  #{topico.comentarios ? topico.comentarios.length : 0} respostas
                  span.forum-date
                    i.bi.bi-calendar(aria-hidden="true")
                    |  #{new Date(topico.data_postagem).toLocaleDateString('pt-BR')}
                  i.bi.bi-chevron-right(aria-hidden="true")

        .view-all-link
          a(href="/forum" aria-label="Ver todas as postagens no fórum") Ver todas

      //- TAB: MATERIAIS
      .tab-content#tab-materiais.tab-pane(role="tabpanel" aria-labelledby="tab-btn-materiais" hidden)
        .materiais-list
          if materiais.length === 0
            p(style="color:#6B7280; padding: 20px") Você ainda não publicou nenhum material.
          each material in materiais
            .material-item
              a.material-item-link(href=`/material/${material.id}` style="display:flex; align-items:center; gap:12px; flex:1; min-width:0; text-decoration:none; color:inherit;")
                .material-icon
                  i.bi(class=material.tipo_material === 'video' ? 'bi-play-circle' : 'bi-file-earmark-pdf')
                .material-content
                  h3.material-title= material.titulo
                  p.material-info
                    = material.tipo_material === 'video' ? 'Vídeo' : (material.tipo_material === 'slide' ? 'Apresentação' : (material.tipo_material === 'artigo' ? 'Artigo' : 'Documento'))
                    |  • #{new Date(material.data_publicacao).toLocaleDateString('pt-BR')}
              .material-action
                a.btn-download(href=material.caminho_arquivo target="_blank" rel="noopener" aria-label=`Baixar ${material.titulo}`)
                  i.bi.bi-download(aria-hidden="true")

        .view-all-link
          a(href="/biblioteca" aria-label="Ver todos os materiais") Ver todas

  
  .modal-overlay#modalEditar(style="display:none" role="dialog" aria-modal="true" aria-labelledby="modal-editar-titulo")
    .modal-edicao
      .modal-header
        h3#modal-editar-titulo Editar perfil
        button.btn-fechar-modal(type="button" onclick="fecharModalEditar()" aria-label="Fechar")
          i.bi.bi-x-lg(aria-hidden="true")

      form#formEditarPerfil(action="/usuario/editar-perfil" method="POST" enctype="multipart/form-data")
        .modal-body
          .modal-avatar-section
            img#previewAvatar(src='/images/foto-perfil-default.png' alt="Avatar")
            label.btn-foto(for="novaFoto")
              i.bi.bi-camera-fill(aria-hidden="true")
              | Alterar foto
            input#novaFoto(type="file" name="foto" accept="image/*" hidden)

          .modal-campos
            .input-group
              i.bi.bi-person-fill(aria-hidden="true")
              .input-content
                label(for="novo_nome_usuario") Nome de usuário
                input#novo_nome_usuario(type="text" name="nome_usuario" value=usuario.nome_usuario)
                if podeTrocarNome
                  small.hint Você pode trocar seu nome de usuário
                else
                  small.hint.bloqueado Disponível para troca em #{diasRestantes} dias

            .input-group
              i.bi.bi-card-text(aria-hidden="true")
              .input-content
                label(for="nova_biografia") Biografia
                textarea#nova_biografia(name="biografia" rows="3")= usuario.biografia || ''

        .modal-footer
          button.btn-cancel(type="button" onclick="fecharModalEditar()") Cancelar
          button.btn-submitcust(type="submit") Salvar
  script(src="/javascripts/perfil.js")
